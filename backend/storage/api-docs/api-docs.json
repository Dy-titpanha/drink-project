{
    "openapi": "3.0.0",
    "info": {
        "title": "System Cafe & Milk Tea API Documentation",
        "description": "Welcome to the **System Cafe & Milk Tea POS API Documentation**!\n\n### 🔑 Available Test Login Accounts:\n\n| Role | Email | Password | Access Privileges |\n| :--- | :--- | :--- | :--- |\n| **Admin** | `admin@cafe.com` | `password123` | Full access (Products, Orders, Admin Dashboard Stats, Manage Users) |\n| **User (Staff)** | `user@cafe.com` | `password123` | Staff access (Products view/create, Checkout Orders) |\n| **Customer** | `customer@cafe.com` | `password123` | Customer access (Browse Menu, Place Orders, Profile management) |\n\n---\n### 🛡️ How to Authenticate:\n1. Call **`POST /api/auth/login`** with one of the test accounts above.\n2. Copy the returned `token` from the response.\n3. Click the **Authorize** button at the top right of this Swagger UI page.\n4. Paste the token into the **Value** box and click **Authorize**.\n",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Current Server (Relative)"
        },
        {
            "url": "http://127.0.0.1:8000",
            "description": "Local 127.0.0.1 Server"
        },
        {
            "url": "http://localhost:8000",
            "description": "Localhost Server"
        }
    ],
    "paths": {
        "/api/auth/register": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Register a new account (Admin, Staff User, or Customer)",
                "description": "Register a new user account.",
                "operationId": "c7bb21a0d87049e161b8e4c9b0d909f2",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "John Customer"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "john@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "role": {
                                        "type": "string",
                                        "example": "customer",
                                        "enum": [
                                            "admin",
                                            "user",
                                            "customer"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User registered successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Login with email only (Supports Admin, User, Customer accounts)",
                "description": "Test accounts: \n- **Admin**: `admin@cafe.com` \n- **Staff User**: `user@cafe.com` \n- **Customer**: `customer@cafe.com`",
                "operationId": "dd51a484b7fa0f97c7680fdbde14cf5f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@cafe.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful with token"
                    },
                    "401": {
                        "description": "Invalid credentials"
                    }
                }
            }
        },
        "/api/auth/profile": {
            "get": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Get currently logged-in user profile",
                "description": "Get authenticated user profile.",
                "operationId": "b1eb3bba5d25e3becff8e61e26215556",
                "responses": {
                    "200": {
                        "description": "Profile data"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Update profile details",
                "description": "Update profile (name / email).",
                "operationId": "c32ae167f9972ce3b08a338ab033f74c",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Updated Name"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "updated@cafe.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Profile updated successfully"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/auth/password": {
            "put": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Update user account password",
                "description": "Update password.",
                "operationId": "18255818fe181bddad75ae783faa2456",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "current_password",
                                    "password"
                                ],
                                "properties": {
                                    "current_password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "newpassword123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password updated successfully"
                    },
                    "400": {
                        "description": "Incorrect current password"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/auth/logout": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Logout user and revoke token",
                "description": "Logout (revoke current token).",
                "operationId": "df9bdc6c7a6d9f20b983526b2ec0f698",
                "responses": {
                    "200": {
                        "description": "Logged out successfully"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/dashboard/stats": {
            "get": {
                "tags": [
                    "Admin Dashboard"
                ],
                "summary": "Get overall store stats, revenue, orders & staff list (Admin only)",
                "description": "Get comprehensive dashboard statistics (admin only).",
                "operationId": "654e1617f74d2b9e0654ec77620d960b",
                "responses": {
                    "200": {
                        "description": "Dashboard summary data"
                    },
                    "403": {
                        "description": "Forbidden - Admin access required"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/checkout": {
            "post": {
                "tags": [
                    "Orders & Checkout"
                ],
                "summary": "Place a new order (Checkout)",
                "description": "Process a checkout (place order).",
                "operationId": "c90fce9fa5e9860be3ce8ede472afc4f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "cart",
                                    "payment_method"
                                ],
                                "properties": {
                                    "cart": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "price": {
                                                    "type": "number",
                                                    "example": 3.5
                                                },
                                                "quantity": {
                                                    "type": "integer",
                                                    "example": 2
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "payment_method": {
                                        "type": "string",
                                        "example": "ABA KHQR"
                                    },
                                    "customer_name": {
                                        "type": "string",
                                        "example": "John Customer"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Order placed successfully"
                    },
                    "500": {
                        "description": "Checkout failed"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/projects": {
            "get": {
                "tags": [
                    "Products & Projects"
