                                    "image": {
                                        "type": "string",
                                        "example": "https://images.unsplash.com/photo-1541658016709-82535e94bc69?w=500"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Creamy iced matcha latte with fresh milk"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Product created successfully"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
